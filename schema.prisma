generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum ActivityStatus { PENDING APPROVED REJECTED }
enum RequestStatus { PENDING APPROVED REJECTED }
enum CoinType { ACTIVITY_REWARD ADMIN_ADD ADMIN_REMOVE PENALTY MANUAL }
enum Priority { LOW NORMAL HIGH URGENT }

model User { id String @id @default(cuid()); username String @unique; passwordHash String; name String; discordId String?; coin Int @default(0); playtimeMinutes Int @default(0); joinDate DateTime @default(now()); lastLogin DateTime?; online Boolean @default(false); active Boolean @default(true); isOwner Boolean @default(false); rankId String; divisionId String?; rank Rank @relation(fields:[rankId],references:[id]); division Division? @relation(fields:[divisionId],references:[id]); activities Activity[]; dispatched Activity[] @relation("Dispatch"); verified Activity[] @relation("Verifier"); coins CoinTransaction[]; rankHistory RankHistory[]; sessions PlaytimeSession[]; announcements Announcement[]; logs AuditLog[]; userPermissions UserPermission[]; requests DivisionRequest[]; decisions DivisionRequest[] @relation("Decision"); resets PasswordReset[]; notifications Notification[]; headDivisions Division[] @relation("Head"); managedDivisions Division[] @relation("Manager"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Rank { id String @id @default(cuid()); level Int @unique; name String; coinRequired Int @default(0); users User[]; permissions RankPermission[];  }
model Permission { id String @id @default(cuid()); key String @unique; description String?; ranks RankPermission[]; users UserPermission[] }
model RankPermission { rankId String; permissionId String; rank Rank @relation(fields:[rankId],references:[id],onDelete:Cascade); permission Permission @relation(fields:[permissionId],references:[id],onDelete:Cascade); @@id([rankId,permissionId]) }
model UserPermission { userId String; permissionId String; user User @relation(fields:[userId],references:[id],onDelete:Cascade); permission Permission @relation(fields:[permissionId],references:[id],onDelete:Cascade); @@id([userId,permissionId]) }
model Division { id String @id @default(cuid()); name String @unique; description String?; minimumRankLevel Int @default(3); headId String?; managerId String?; head User? @relation("Head",fields:[headId],references:[id]); manager User? @relation("Manager",fields:[managerId],references:[id]); users User[]; requests DivisionRequest[] }
model Activity { id String @id @default(cuid()); userId String; dispatchId String?; verifiedById String?; type String; location String; occurredAt DateTime; description String; coinReward Int @default(10); status ActivityStatus @default(PENDING); verificationReason String?; verifiedAt DateTime?; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id]); dispatch User? @relation("Dispatch",fields:[dispatchId],references:[id]); verifier User? @relation("Verifier",fields:[verifiedById],references:[id]); coins CoinTransaction[] }
model CoinTransaction { id String @id @default(cuid()); userId String; actorId String?; activityId String?; amount Int; type CoinType; reason String; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id]); activity Activity? @relation(fields:[activityId],references:[id]) }
model RankHistory { id String @id @default(cuid()); userId String; actorId String?; fromRank String; toRank String; reason String?; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id]);  }
model PlaytimeSession { id String @id @default(cuid()); userId String; loginAt DateTime; logoutAt DateTime?; durationMinutes Int @default(0); user User @relation(fields:[userId],references:[id]) }
model DivisionRequest { id String @id @default(cuid()); userId String; divisionId String; status RequestStatus @default(PENDING); message String?; decidedById String?; decisionReason String?; decidedAt DateTime?; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id]); division Division @relation(fields:[divisionId],references:[id]); decidedBy User? @relation("Decision",fields:[decidedById],references:[id]) }
model Announcement { id String @id @default(cuid()); title String; description String; priority Priority @default(NORMAL); authorId String; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; author User @relation(fields:[authorId],references:[id]) }
model AuditLog { id String @id @default(cuid()); actorId String?; action String; targetType String; targetId String?; details String; ipAddress String?; createdAt DateTime @default(now()); actor User? @relation(fields:[actorId],references:[id]) }
model PasswordReset { id String @id @default(cuid()); userId String; token String @unique; expiresAt DateTime; usedAt DateTime?; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id]) }
model Notification { id String @id @default(cuid()); userId String; title String; message String; readAt DateTime?; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id]) }
